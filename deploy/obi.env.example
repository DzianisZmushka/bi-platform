# Copy to deploy/obi.env (gitignored), fill in, chmod 600.
# A private repository: an HTTPS URL with a read-only token. It is never shown on pages or in logs.
OBI_GIT_URL=https://x-access-token:<read-only token>@github.com/<owner>/<repo>.git
OBI_GIT_BRANCH=main
# The project's directory inside the repository (empty when project.yaml is at the root).
OBI_GIT_PATH=examples/erp-sales
# Long random strings, e.g. `python -c "import secrets; print(secrets.token_hex(32))"`.
OBI_SECRET_KEY=
OBI_DEPLOY_TOKEN=
